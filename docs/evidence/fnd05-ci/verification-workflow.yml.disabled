name: Verify FND-05 APK artifact download

on:
  push:
    branches: [verification/fnd-05-artifact-download]
  workflow_dispatch:

permissions:
  contents: read
  actions: read

concurrency:
  group: nowia-fnd05-artifact-verification-${{ github.ref }}
  cancel-in-progress: false

jobs:
  verify-download:
    runs-on: ubuntu-26.04
    timeout-minutes: 15
    defaults:
      run:
        shell: bash
    env:
      SOURCE_REPOSITORY: Refstop/Nowia
      SOURCE_RUN_ID: '38382751680'
      SOURCE_RUN_ATTEMPT: '1'
      SOURCE_HEAD_SHA: de79ee491bc95938357689ab3053537f215ef01e
      SOURCE_ARTIFACT_NAME: nowia-upstream-debug-38382751680-1
      EXPECTED_APK_NAME: app-production-debug.apk
      EXPECTED_APK_SHA256: ab5d88c3cc614e152431da8a14fa5f73839f4e2378fdd56073899fd1df47a4de
    steps:
      - name: Validate the source run and artifact metadata
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python3 - <<'PY'
          import datetime
          import json
          import os
          from pathlib import Path
          import re
          import urllib.request

          evidence = Path("verification-evidence")
          evidence.mkdir()
          result = {
              "checked_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
              "source_repository": os.environ["SOURCE_REPOSITORY"],
              "source_run_id": int(os.environ["SOURCE_RUN_ID"]),
              "source_run_attempt": int(os.environ["SOURCE_RUN_ATTEMPT"]),
              "source_run_head_sha_expected": os.environ["SOURCE_HEAD_SHA"],
              "source_artifact_name": os.environ["SOURCE_ARTIFACT_NAME"],
              "apk_name_expected": os.environ["EXPECTED_APK_NAME"],
              "apk_sha256_expected": os.environ["EXPECTED_APK_SHA256"],
              "verification_run_id": int(os.environ["GITHUB_RUN_ID"]),
              "verification_run_attempt": int(os.environ["GITHUB_RUN_ATTEMPT"]),
              "source_validation": "FAIL",
              "downloaded_apk_verification": "NOT_RUN",
          }

          def get_json(path):
              request = urllib.request.Request(
                  "https://api.github.com" + path,
                  headers={
                      "Accept": "application/vnd.github+json",
                      "Authorization": "Bearer " + os.environ["GH_TOKEN"],
                      "X-GitHub-Api-Version": "2022-11-28",
                  },
              )
              with urllib.request.urlopen(request, timeout=30) as response:
                  return json.load(response)

          try:
              if not re.fullmatch(r"[0-9a-f]{64}", result["apk_sha256_expected"]):
                  raise ValueError("Fill EXPECTED_APK_SHA256 with the source build's verified SHA-256 before publishing.")
              base = f"/repos/{result['source_repository']}/actions/runs/{result['source_run_id']}"
              run = get_json(base)
              result["source_run_url"] = run["html_url"]
              result["source_run_head_sha"] = run["head_sha"]
              result["source_run_status"] = run["status"]
              result["source_run_conclusion"] = run["conclusion"]
              if (run["id"] != result["source_run_id"]
                      or run["run_attempt"] != result["source_run_attempt"]
                      or run["head_sha"] != result["source_run_head_sha_expected"]
                      or run["status"] != "completed"
                      or run["conclusion"] != "success"):
                  raise ValueError("The source workflow run does not match the expected successful run.")
              artifacts = get_json(base + "/artifacts?per_page=100")["artifacts"]
              selected = [item for item in artifacts if item["name"] == result["source_artifact_name"]]
              if len(selected) != 1 or selected[0]["expired"]:
                  raise ValueError("The exact source artifact is missing, ambiguous or expired.")
              artifact = selected[0]
              workflow_run = artifact.get("workflow_run") or {}
              if (workflow_run.get("id") != result["source_run_id"]
                      or workflow_run.get("head_sha") != result["source_run_head_sha_expected"]):
                  raise ValueError("Artifact metadata does not match the expected run and head SHA.")
              result["source_artifact"] = {
                  key: artifact.get(key)
                  for key in ("id", "name", "size_in_bytes", "digest", "created_at", "expires_at")
              }
              result["source_validation"] = "PASS"
          except Exception as exc:
              result["error"] = f"{type(exc).__name__}: {exc}"
              raise
          finally:
              (evidence / "verification.json").write_text(json.dumps(result, indent=2) + "\n")
              print(json.dumps(result, indent=2))
          PY
      - name: Download the original APK artifact from the source run
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          github-token: ${{ github.token }}
          repository: Refstop/Nowia
          run-id: '38382751680'
          name: nowia-upstream-debug-38382751680-1
          path: downloaded-apk
          digest-mismatch: error
      - name: Compare the downloaded APK with the source build SHA-256
        run: |
          python3 - <<'PY'
          import datetime
          import hashlib
          import json
          import os
          from pathlib import Path

          evidence = Path("verification-evidence")
          result_path = evidence / "verification.json"
          result = json.loads(result_path.read_text())
          result["downloaded_apk_verification"] = "FAIL"
          try:
              apk = Path("downloaded-apk") / os.environ["EXPECTED_APK_NAME"]
              files = [path for path in Path("downloaded-apk").rglob("*") if path.is_file()]
              if files != [apk] or apk.is_symlink() or apk.stat().st_size == 0:
                  raise ValueError("The artifact must contain exactly the expected nonempty APK file.")
              digest = hashlib.sha256()
              with apk.open("rb") as stream:
                  for block in iter(lambda: stream.read(1024 * 1024), b""):
                      digest.update(block)
              actual = digest.hexdigest()
              result["downloaded_apk"] = {
                  "name": apk.name,
                  "bytes": apk.stat().st_size,
                  "sha256": actual,
              }
              (evidence / "apk.sha256.txt").write_text(f"{actual}  {apk.name}\n")
              if actual != result["apk_sha256_expected"]:
                  raise ValueError("The downloaded APK SHA-256 differs from the source build evidence.")
              result["downloaded_apk_verification"] = "PASS"
          except Exception as exc:
              result["error"] = f"{type(exc).__name__}: {exc}"
              raise
          finally:
              result["finished_utc"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
              result_path.write_text(json.dumps(result, indent=2) + "\n")
              print(json.dumps(result, indent=2))
          PY
      - name: Preserve download verification evidence
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: nowia-artifact-download-verification-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            verification-evidence/*.json
            verification-evidence/*.txt
          if-no-files-found: error
          retention-days: 14
